#!/bin/sh
set -eu

SCRIPT_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
WATCHDOG_DIR="$(dirname "$SCRIPT_DIR")"
REPO_DIR="$(dirname "$WATCHDOG_DIR")"
CONFIG_DIR="$REPO_DIR/configs"

SRC="$CONFIG_DIR/wg0-creds.conf"
OUT="$CONFIG_DIR/wg0.conf"
TMP="$CONFIG_DIR/wg0.conf.tmp"

[ -f "$SRC" ] || { echo "Missing $SRC"; exit 1; }

PRIVATE_KEY="$(awk -F '= ' '/^PrivateKey/ {print $2}' "$SRC")"
ADDRESS="$(awk -F '= ' '/^Address/ {print $2}' "$SRC")"
PUBLIC_KEY="$(awk -F '= ' '/^PublicKey/ {print $2}' "$SRC")"
ENDPOINT="$(awk -F '= ' '/^Endpoint/ {print $2}' "$SRC")"
PSK="$(awk -F '= ' '/^PresharedKey/ {print $2}' "$SRC" || true)"

: "${PRIVATE_KEY:?Missing PrivateKey}"
: "${ADDRESS:?Missing Address}"
: "${PUBLIC_KEY:?Missing PublicKey}"
: "${ENDPOINT:?Missing Endpoint}"

mkdir -p "$CONFIG_DIR"
chmod 700 "$CONFIG_DIR"

PSK_LINE=""
if [ -n "${PSK:-}" ]; then
  PSK_LINE="PresharedKey = ${PSK}"
fi
: "${LAN_IF:?}"
: "${LAN_GW:?}"
: "${VPN_HOST:?}"
: "${VPN_NET:?}"
: "${VPN_DNS:?}"
: "${LOCAL_NETS:?}"
: "${OUTBOUND_NETS:?}"

OUTBOUND_NETS_RULES=""
priority=70

for net in $OUTBOUND_NETS; do
  OUTBOUND_NETS_RULES="${OUTBOUND_NETS_RULES}
PostUp = ip rule del to ${net} lookup main priority ${priority} 2>/dev/null || true
PostUp = ip rule add to ${net} lookup main priority ${priority}
PostDown = ip rule del to ${net} lookup main priority ${priority} 2>/dev/null || true"
  priority=$((priority + 1))
done

LOCAL_NETS_RULES=""

for net in $LOCAL_NETS; do
  LOCAL_NETS_RULES="${LOCAL_NETS_RULES}
PostUp = ip route replace ${net} via ${LAN_GW} dev ${LAN_IF}
PostDown = ip route del ${net} via ${LAN_GW} dev ${LAN_IF} 2>/dev/null || true"
done


cat >"$TMP" <<CONF
[Interface]
PrivateKey = ${PRIVATE_KEY}
MTU = 1380
Address = ${ADDRESS}

# keep gateway management on LAN
PostUp = ip rule del from ${VPN_HOST}/32 lookup main priority 50 2>/dev/null || true
PostUp = ip rule add from ${VPN_HOST}/32 lookup main priority 50
PostDown = ip rule del from ${VPN_HOST}/32 lookup main priority 50 2>/dev/null || true

# PIA DNS must stay in tunnel
PostUp = ip rule del to ${VPN_DNS}/32 lookup 51820 priority 60 2>/dev/null || true
PostUp = ip rule add to ${VPN_DNS}/32 lookup 51820 priority 60
PostDown = ip rule del to ${VPN_DNS}/32 lookup 51820 priority 60 2>/dev/null || true

# local networks must stay off VPN
${OUTBOUND_NETS_RULES}

# explicit LAN routes in main table
${LOCAL_NETS_RULES}

[Peer]
PublicKey = ${PUBLIC_KEY}
${PSK_LINE}
Endpoint = ${ENDPOINT}
AllowedIPs = 0.0.0.0/0
PersistentKeepalive = 60
CONF

chmod 600 "$TMP"

if [ -f "$OUT" ] && cmp -s "$TMP" "$OUT"; then
  echo "wg0.conf unchanged"
  rm -f "$TMP"
  exit 0
fi

mv -f "$TMP" "$OUT"
echo "wg0.conf updated: $OUT"
